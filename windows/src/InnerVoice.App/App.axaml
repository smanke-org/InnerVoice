<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InnerVoice.App.App"
             Name="InnerVoice"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#4F46E5</Color>
                    <Color x:Key="SystemAccentColorLight1">#6366F1</Color>
                    <Color x:Key="SystemAccentColorDark1">#4338CA</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#6366F1</Color>
                    <Color x:Key="SystemAccentColorLight1">#818CF8</Color>
                    <Color x:Key="SystemAccentColorDark1">#4F46E5</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
