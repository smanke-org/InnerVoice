<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>InnerVoice</AssemblyName>
    <RootNamespace>InnerVoice.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\InnerVoice.ico')">Assets\InnerVoice.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- A Windows build (dotnet publish -r win-x64 / win-arm64) targets the Windows SDK, for
       WinRT speech (Windows' OneCore voices) and Media Foundation (M4A). Builds without a
       Windows runtime (tests on the Mac, `dotnet run` on a PC) are plain net10.0: there the
       system voices come through SAPI (System.Speech) on Windows, and nothing elsewhere. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
    <!-- Audio out (WinMM) on Windows; SAPI voices when WinRT isn't there. Both are no-ops
         elsewhere (the app checks OperatingSystem.IsWindows()). -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>
  <!-- Reading MP3, M4A and other recordings for Clone a Voice › On This PC (Media Foundation). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- DirectML.dll for ONNX Runtime's DirectML provider (the local voices on the graphics
         card). Its package only copies it for C++ platform targets, so it's copied here. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64'">
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\$(RuntimeIdentifier.Substring(4))-win\DirectML.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="DirectML.dll" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InnerVoice.Core\InnerVoice.Core.csproj" />
    <ProjectReference Include="..\InnerVoice.Agent\InnerVoice.Agent.csproj" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- llama.cpp b11205 for Windows (tools/fetch-llama.sh), copied next to the app. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' And Exists('..\..\native\$(RuntimeIdentifier)')">
    <None Include="..\..\native\$(RuntimeIdentifier)\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- The `innervoice` CLI (src/InnerVoice.Cli) goes into the app's cli\ folder: one small
       self-contained file, since a windowed program gets no console on Windows. -->
  <Target Name="PublishAgentCli" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(MSBuildThisFileDirectory)../InnerVoice.Cli/InnerVoice.Cli.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained -p:PublishSingleFile=true -p:DebugType=none -o &quot;$(PublishDir)cli&quot;" />
  </Target>
</Project>
