<Project Sdk="Microsoft.NET.Sdk">
  <!-- The book, its lines and cast, importers, dialogue finding, attribution rules,
       prompts, revisions. No UI, so tests run without the app (like InnerVoiceKit). -->
  <PropertyGroup>
    <RootNamespace>InnerVoice.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.1" />
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
  </ItemGroup>
  <!-- Pocket TTS's stock voices: the Mac's nine clips (Resources/StockVoices) as 16-bit WAV,
       made by tools/make-stock-voices.sh. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\StockVoices\*.wav" LogicalName="StockVoices.%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The local neural voices (Pocket TTS, Orpheus): ONNX Runtime. Windows builds get the
       DirectML package (GPU through DirectX 12, falling back to the CPU); everything else,
       including the tests on a Mac, the CPU package. Both ship the same managed API. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>
</Project>
