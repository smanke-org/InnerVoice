<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. pack.ps1 fills the {{…}} values: identity from store.json
     (copied from Partner Center › Product identity), the version from Directory.Build.props
     (A.B.C becomes A.B.C.0), the architecture per build. The Store signs the package. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{{IdentityName}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="{{Architecture}}" />

  <Properties>
    <DisplayName>InnerVoice</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- llama.cpp needs the Visual C++ runtime; the Store installs this with the app. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.33519.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="InnerVoice" Executable="InnerVoice.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="InnerVoice"
        Description="Who's speaking, for audiobook narrators."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="innervoice">
            <uap:DisplayName>InnerVoice Project</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.innervoice</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- innervoice:// links (src/InnerVoice.Agent/AgentUrl.cs): Windows starts InnerVoice.exe
             with the link, which hands it to a running InnerVoice through the agent pipe. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="innervoice" Parameters="&quot;%1&quot;">
            <uap:DisplayName>InnerVoice Link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
    <!-- The `innervoice` command for agents and scripts (src/InnerVoice.Cli, a console program
         in cli\): the alias puts innervoice.exe on PATH. Not in the Start menu. -->
    <Application Id="InnerVoiceCli" Executable="cli\innervoice.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="innervoice"
        Description="The InnerVoice command line, for agents and scripts."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="cli\innervoice.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="innervoice.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Model downloads from Hugging Face, and Claude (api.anthropic.com) only with the narrator's key and each book's yes. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
